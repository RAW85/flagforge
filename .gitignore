# =============================================================================
# FlagForge monorepo — primary ignore list (paths from repo root)
# Nested backend/.gitignore and frontend/.gitignore also apply in those folders.
# =============================================================================

# --- Gradle / Java ---
.gradle/
backend/.gradle/
backend/build/
**/build/
!backend/gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/
*.class
*.jar
!**/gradle-wrapper.jar
*.war
*.ear
hs_err_pid*
replay_pid*
backend/out/
backend/bin/

# --- Node / frontend ---
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
frontend/.vite/
frontend/*.tsbuildinfo
frontend/out/

# --- Demo (keep screens/ + out/*.mp4 in git; ignore local scratch) ---
demo/out/raw/
demo/tools/
demo/**/*.webm

# --- IDE / editors ---
.idea/
**/.idea/
.vscode/
!.vscode/extensions.json
*.iml
*.iws
*.ipr
*.suo
*.ntvs*
*.njsproj
*.sln
.project
.classpath
.settings/
.factorypath
.apt_generated
.springBeans
.sts4-cache

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Env / secrets (deploy/*.env are intentional public samples — keep them) ---
.env
.env.*
!.env.example
*.pem
*.p12
*.jks
*.local

# --- Logs / runtime ---
*.log
logs/
**/.flagforge/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Misc ---
*.tmp
*.swp
*~
.cache/
